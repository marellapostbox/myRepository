<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0"
         metadata-complete="false">

    <display-name>Yamin Zumba App</display-name>

    <servlet>
        <servlet-name>BatchServlet</servlet-name>
        <servlet-class>com.yamin.servlet.BatchServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BatchServlet</servlet-name>
        <url-pattern>/batches</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ParticipantServlet</servlet-name>
        <servlet-class>com.yamin.servlet.ParticipantServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ParticipantServlet</servlet-name>
        <url-pattern>/participants</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminLoginServlet</servlet-name>
        <servlet-class>com.yamin.servlet.AdminLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminLoginServlet</servlet-name>
        <url-pattern>/admin-login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ParticipantLoginServlet</servlet-name>
        <servlet-class>com.yamin.servlet.ParticipantLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ParticipantLoginServlet</servlet-name>
        <url-pattern>/participant-login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.yamin.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- RegisterParticipantServlet: added for explicit mapping (also available via @WebServlet annotation) -->
    <servlet>
        <servlet-name>RegisterParticipantServlet</servlet-name>
        <servlet-class>com.yamin.servlet.RegisterParticipantServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterParticipantServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <filter>
        <filter-name>AdminFilter</filter-name>
        <filter-class>com.yamin.filter.AdminFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AdminFilter</filter-name>
        <url-pattern>/addBatch.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AdminFilter</filter-name>
        <url-pattern>/batches</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AdminFilter</filter-name>
        <url-pattern>/participants</url-pattern>
    </filter-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>
